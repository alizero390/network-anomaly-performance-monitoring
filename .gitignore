# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/

# Local machine configuration
configs/paths.toml
.env
.env.*
!.env.example

# Machine learning models (large, regenerated by scripts)
models/
*.joblib
*.pkl
*.pickle

# Large generated experimental outputs
results/validation_predictions.csv
results/**/*_predictions.csv
results/validation_categories.csv

# Datasets (never committed)
data/
*.parquet

# Editors: shared VS Code settings are committed, personal state is not
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
*.tmp
